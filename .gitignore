# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# SQLite-Datenbank (lokale Entwicklungsdaten, nicht versionieren)
/prisma/dev.db
/prisma/dev.db-journal
/dev.db
/dev.db-journal

# Hochgeladene Bewerbungsunterlagen (persönliche Dokumente, nicht versionieren)
/public/uploads/*
!/public/uploads/.gitkeep

# Von `prisma init` installierte generische Prisma-CLI-Referenzdokumente für
# KI-Coding-Assistenten (nicht projektspezifisch, daher nicht versioniert)
/.agents/
/.claude/skills/
/.windsurf/
skills-lock.json
