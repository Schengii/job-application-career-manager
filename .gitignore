# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Lokal automatisch erzeugter Verschlüsselungsschlüssel für Geheimnisse
# at-rest (z.B. den KI-API-Key), falls ENCRYPTION_KEY nicht gesetzt ist.
# Siehe src/lib/secretCrypto.ts. Darf niemals versioniert werden.
/.encryption-key

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# SQLite-Datenbank (lokale Entwicklungsdaten, nicht versionieren)
/prisma/dev.db
/prisma/dev.db-journal
/dev.db
/dev.db-journal

# SQLite-Testdatenbank (wird von vitest.global-setup.ts bei jedem Testlauf neu erzeugt)
/prisma/test.db
/prisma/test.db-journal

# SQLite-E2E-Testdatenbank (wird von e2e/global-setup.mts bei jedem Playwright-Lauf neu erzeugt)
/prisma/e2e.db
/prisma/e2e.db-journal

# Playwright: Testberichte/-artefakte (Screenshots, Traces, HTML-Report)
/playwright-report/
/test-results/
/blob-report/

# Hochgeladene Bewerbungsunterlagen (persönliche Dokumente, nicht versionieren)
/public/uploads/*
!/public/uploads/.gitkeep

# Automatische Sicherheitskopien vor destruktiven Aktionen (Bulk-Löschung,
# Restore) — enthält dieselben persönlichen Daten wie dev.db, siehe
# src/lib/serverBackupRotation.ts. Nicht versionieren.
/backups/

# ECHTE persönliche Bewerbungsunterlagen (Name, Adresse, Zeugnisse, verschickte
# Bewerbungen etc.) – enthält sensible personenbezogene Daten und darf NIEMALS
# in dieses (öffentliche!) Repository gelangen.
/Bewerbungsunterlagen final/
/scripts/profile-data.local.json

# Von `prisma init` installierte generische Prisma-CLI-Referenzdokumente für
# KI-Coding-Assistenten (nicht projektspezifisch, daher nicht versioniert)
/.agents/
/.claude/skills/
/.windsurf/
skills-lock.json
