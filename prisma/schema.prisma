// ---------------------------------------------------------------------------
// Prisma Schema — Job Application & Career Manager
// ---------------------------------------------------------------------------
// Datenbank: SQLite (lokale Datei, siehe .env -> DATABASE_URL).
// SQLite unterstützt in Prisma keine nativen Enums, daher werden Status- und
// Kategorie-Felder als String abgebildet und auf Anwendungsebene über
// TypeScript-Literal-Unions + Zod validiert (siehe src/lib/constants.ts).
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Unternehmen — jede Firma, bei der man sich beworben hat oder bewerben könnte
// ---------------------------------------------------------------------------
model Company {
  id            String   @id @default(cuid())
  name          String
  street        String?
  postalCode    String?
  city          String?
  country       String   @default("Deutschland")
  website       String?
  contactName   String? // Ansprechpartner
  contactEmail  String?
  contactPhone  String?
  notes         String? // Freitext-Notizen zum Unternehmen
  tags          String? // kommasepariert, z.B. "Startup,Remote,Prio1"
  status        String   @default("LEAD") // LEAD | CONTACTED | IN_PROGRESS | PARTNER | REJECTED | ARCHIVED
  // Eigener Standard-Einstiegsabsatz für Anschreiben an dieses Unternehmen —
  // überschreibt (falls gesetzt) den automatisch generierten Intro-Absatz in
  // src/lib/coverLetterGenerator.ts, der Rest des Anschreibens (Werdegang,
  // Projekt, Abschluss) wird weiterhin automatisch erzeugt.
  letterTemplate String?
  preferredTone  String? // Bevorzugte Anschreiben-Tonalität für dieses Unternehmen: MODERN | CLASSIC | STARTUP | DETAILED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobPostings   JobPosting[]
  applications  Application[]

  @@index([status])
  @@index([name])
}

// ---------------------------------------------------------------------------
// Stellenangebote — gecrawlte / simulierte Jobs von den Jobportalen
// ---------------------------------------------------------------------------
model JobPosting {
  id                  String   @id @default(cuid())
  title               String
  description         String
  portalSource        String // STEPSTONE | INDEED | GETINIT | ARBEITSAGENTUR | OTHER
  sourceUrl           String?
  location             String?
  remote              Boolean  @default(false)
  requirementsProfile String? // Freitext Anforderungsprofil
  techStack           String? // kommasepariert, z.B. "TypeScript,React,CSS"
  salaryInfo          String?
  matchScore          Int? // zuletzt berechneter Match-Score in % (0-100)
  isDismissed         Boolean  @default(false)
  dismissReason       String?  // z.B. "UNWANTED_COMPANY" | "TECH_MISMATCH" | "LOCATION_MISMATCH" | "SENIORITY_MISMATCH" | "SALARY_TOO_LOW" | "OTHER"
  dismissedAt         DateTime?
  postedAt            DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  applications Application[]

  @@index([portalSource])
  @@index([companyId])
  @@index([isDismissed])
}

// ---------------------------------------------------------------------------
// Bewerbungen — Kernentität: verknüpft Unternehmen, Stelle, Status & Dokumente
// ---------------------------------------------------------------------------
model Application {
  id              String    @id @default(cuid())
  position        String // Job-Titel (denormalisiert, falls kein JobPosting verknüpft ist)
  status          String    @default("DRAFT") // DRAFT | SENT | INTERVIEW | OFFER | REJECTED | WITHDRAWN
  applicationDate DateTime? // Datum, an dem die Bewerbung abgeschickt wurde
  nextStep        String? // z.B. "Rückmeldung abwarten", "Vorstellungsgespräch am ..."
  nextStepDate    DateTime?
  meetingUrl      String? // z.B. Teams, Zoom, Google Meet Link oder Tel
  rejectionReason String? // z.B. "Zu wenig Berufserfahrung", "Gehaltserwartung", "Stelle gestrichen"
  interviewStage  String? // SCREENING | CODING_CHALLENGE | TECH_INTERVIEW | FINAL_ROUND | OFFER_STAGE
  timeSpentMinutes Int?   @default(0) // Aufwand in Minuten (Recherche, Anschreiben, Vorbereitung)
  tags            String? // kommasepariert, z.B. "Prio1,Frontend,Empfehlung"
  notes           String?
  source          String? // z.B. "Stepstone", "Initiativbewerbung"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  jobPostingId String?
  jobPosting   JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)

  statusEvents      ApplicationStatusEvent[]
  interactions      ApplicationInteraction[]
  documents         ApplicationDocument[]
  coverLetter       CoverLetter?

  @@index([companyId])
  @@index([jobPostingId])
  @@index([status])
  @@index([applicationDate])
  @@index([nextStepDate])
  @@index([updatedAt])
}

// ---------------------------------------------------------------------------
// Status-Historie — jede Statusänderung einer Bewerbung wird protokolliert
// ---------------------------------------------------------------------------
model ApplicationStatusEvent {
  id            String   @id @default(cuid())
  status        String
  note          String?
  changedAt     DateTime @default(now())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// ---------------------------------------------------------------------------
// Interaktions-Historie — Telefonate, Feedback, Interview-Runden etc.
// ---------------------------------------------------------------------------
model ApplicationInteraction {
  id              String   @id @default(cuid())
  type            String   // CALL | EMAIL | INTERVIEW_ROUND | FEEDBACK | NOTE
  title           String
  summary         String?
  interactionDate DateTime @default(now())
  createdAt       DateTime @default(now())

  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// ---------------------------------------------------------------------------
// Dokumente — Lebenslauf, Zeugnisse, Referenzen etc. (wiederverwendbar)
// ---------------------------------------------------------------------------
model Document {
  id          String   @id @default(cuid())
  name        String
  category    String // LEBENSLAUF | ZEUGNIS_SCHULE | ZEUGNIS_AUSBILDUNG | ZEUGNIS_UMSCHULUNG | REFERENZ | SONSTIGES
  description String?
  fileName    String?
  fileUrl     String? // Pfad unter /public/uploads
  mimeType    String?
  fileSize    Int?
  // Teil des Standard-Bewerbungspakets: wird beim "Direkt bewerben" aus einem
  // Stellenangebot automatisch an die neu angelegte Bewerbung angehängt (siehe
  // /api/jobs/[id]/apply), statt es bei jeder Bewerbung manuell auswählen zu
  // müssen.
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications ApplicationDocument[]

  @@index([category])
}

// Join-Tabelle: n:m zwischen Bewerbung und (wiederverwendbaren) Dokumenten
model ApplicationDocument {
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  attachedAt DateTime @default(now())

  @@id([applicationId, documentId])
  @@index([documentId])
}

// ---------------------------------------------------------------------------
// Anschreiben — automatisch generiert, 1:1 an eine Bewerbung gebunden
// ---------------------------------------------------------------------------
model CoverLetter {
  id          String   @id @default(cuid())
  content     String
  status      String   @default("DRAFT") // DRAFT | SENT
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Präferenzen & Profil — Job-Suchpräferenzen (Singleton, id = "default")
// ---------------------------------------------------------------------------
model Preferences {
  id      String  @id @default("default")
  // Absender-/Kontaktdaten des Bewerbers, werden im Anschreiben-Kopf verwendet
  fullName    String?
  email       String?
  phone       String?
  street      String?
  postalCode  String?
  city        String?

  desiredRole        String   @default("Fachinformatiker für Anwendungsentwicklung")
  techStack          String   @default("TypeScript,JavaScript,CSS,React,Next.js,HTML")
  preferredLocations String   @default("Bonn,Dortmund,Remote")
  searchRadiusKm     Int      @default(50)
  remotePreference   String   @default("HYBRID") // ONSITE | HYBRID | REMOTE | ANY
  minSalary          Int?
  profileSummary     String? // Kurzprofil für den Anschreiben-Generator
  // Fester Anschreiben-Haupttext (Werdegang, Projekt(e), Abschluss) — wird
  // unverändert in jedes generierte Anschreiben übernommen (siehe
  // src/lib/coverLetterGenerator.ts). Nur Empfänger-Adresse, Datum, Anrede
  // und Einleitungssatz variieren pro Bewerbung.
  standardCoverLetterBody   String?
  // Vorlage für den Einleitungssatz mit Platzhaltern {company}/{position}.
  coverLetterOpeningSentence String?
  weeklyGoal         Int      @default(5) // Wochenziel für Bewerbungen
  // Mindest-Match-Score (%), ab dem ein Stellenangebot auf /jobs standardmäßig
  // als "passend" angezeigt wird (0 = Filter deaktiviert, alle anzeigen).
  minMatchScore      Int      @default(0)
  excludedCompanies  String?  // kommasepariert, z.B. "Firma X,Firma Y" (Blacklist)
  excludedKeywords   String?  // kommasepariert, z.B. "Senior,Lead,Cobol,PHP"
  excludedTechStack  String?  // kommasepariert, z.B. "WordPress,Typo3,PHP"
  aiProvider         String?  // openai | anthropic | openrouter | ollama
  aiApiKey           String?
  aiModel            String?
  // Digitales Recruiter-Portfolio / One-Pager
  portfolioShareToken      String?  @unique
  portfolioTokenExpiresAt DateTime?
  portfolioViewCount      Int      @default(0)
  portfolioActive         Boolean  @default(true)
  // E-Mail IMAP Auto-Sync
  imapHost           String?
  imapPort           Int?
  imapUser           String?
  // Verschlüsselt at-rest gespeichert (AES-256-GCM, siehe src/lib/secretCrypto.ts),
  // exakt wie aiApiKey — nie im Klartext an den Client zurückgegeben und nie
  // Teil eines Backup-Exports (src/lib/backup.ts).
  imapPassword       String?
  imapFolder         String?  @default("INBOX")
  imapEnabled        Boolean  @default(false)
  // Hintergrund-Scheduler (src/lib/scheduler.ts): läuft in-process, solange
  // der Server läuft, synct bei aktiviertem IMAP periodisch neue E-Mails und
  // verschickt fällige Push-Benachrichtigungen. Standardmäßig aktiv, hier
  // abschaltbar (Einstellungen -> Automatisierung & Push).
  backgroundSchedulerEnabled Boolean @default(true)
  // Letzter fehlgeschlagener Hintergrund-Tick (siehe runSchedulerTick() in
  // src/lib/scheduler.ts) — bislang landeten IMAP-/Push-/Backup-Fehler nur im
  // Server-Log und blieben für den Nutzer unsichtbar (background-scheduler-card.tsx
  // zeigt sie jetzt als Warnhinweis an). Wird bei jedem Tick ohne Fehler
  // wieder auf null zurückgesetzt.
  lastSchedulerErrorSource  String?   // "email_sync" | "push" | "backup"
  lastSchedulerErrorMessage String?
  lastSchedulerErrorAt      DateTime?
  updatedAt          DateTime @updatedAt

  educationEntries EducationEntry[]
  projectEntries   ProjectEntry[]
}

// ---------------------------------------------------------------------------
// Web-Push-Benachrichtigungen (src/lib/pushNotifications.ts) — eine Zeile pro
// abonnierendem Browser/Gerät.
// ---------------------------------------------------------------------------
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}

// Verhindert doppelten Push-Versand derselben Benachrichtigung: `id` ist
// dieselbe stabile ID wie AppNotification.id aus src/lib/notifications.ts
// (z.B. "status-<eventId>", "overdue-<applicationId>").
model SentPushNotification {
  id     String   @id
  sentAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Ausbildungs-/Bildungsdaten (Schule, Ausbildung, Umschulung, Weiterbildung)
// ---------------------------------------------------------------------------
model EducationEntry {
  id          String    @id @default(cuid())
  type        String // SCHULE | AUSBILDUNG | UMSCHULUNG | WEITERBILDUNG
  title       String // z.B. "Fachinformatiker für Anwendungsentwicklung (Umschulung)"
  institution String?
  startDate   DateTime?
  endDate     DateTime?
  description String?
  sortOrder   Int       @default(0)

  preferencesId String      @default("default")
  preferences   Preferences @relation(fields: [preferencesId], references: [id], onDelete: Cascade)

  @@index([preferencesId])
}

// ---------------------------------------------------------------------------
// Projekt-/Referenzdaten (z.B. "electroCheck-ai")
// ---------------------------------------------------------------------------
model ProjectEntry {
  id          String  @id @default(cuid())
  title       String
  description String?
  techStack   String? // kommasepariert
  url         String?
  role        String?
  sortOrder   Int     @default(0)

  preferencesId String      @default("default")
  preferences   Preferences @relation(fields: [preferencesId], references: [id], onDelete: Cascade)

  @@index([preferencesId])
}
