# ============================================================================
# Job Application & Career Manager — Umgebungsvariablen
# ============================================================================
# Kopiere diese Datei nach ".env" und fülle die Werte aus.
# Für Vercel-Hosting: Variablen im Vercel Dashboard unter
# Project → Settings → Environment Variables hinterlegen.
# ============================================================================

# ----------------------------------------------------------------------------
# Datenbank (Neon PostgreSQL)
# ----------------------------------------------------------------------------
# Neon-Pooler-URL — wird vom @neondatabase/serverless Adapter für
# Laufzeit-Queries in Serverless Functions verwendet.
# Neon Dashboard → Project → Connection Details → "Pooled connection"
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Neon direkte Verbindung — wird von Prisma Migrate für Schema-Änderungen
# genutzt (Pooler unterstützt keine DDL-Statements).
# Neon Dashboard → Project → Connection Details → "Direct connection"
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ----------------------------------------------------------------------------
# Vercel Blob (Datei-Uploads)
# ----------------------------------------------------------------------------
# Automatisch gesetzt wenn du über das Vercel Dashboard Blob aktivierst.
# Für lokale Entwicklung: `vercel env pull .env.local` ausführen.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ----------------------------------------------------------------------------
# Sicherheit & Auth
# ----------------------------------------------------------------------------
# Schützt die gesamte App per HTTP-Basic-Auth (nur das Passwort zählt).
# Für den lokalen Dev-Betrieb NICHT setzen.
# APP_PASSWORD="dein-sicheres-passwort"

# AES-256-GCM Schlüssel für At-Rest-Verschlüsselung (KI-API-Key, IMAP-Passwort).
# Muss ein 32-Byte-Schlüssel als 64-stelliger Hex-String sein.
# Erzeugen: `openssl rand -hex 32`
# ENCRYPTION_KEY="<64 Hex-Zeichen>"

# Geheimnis für Vercel Cron Job Authentifizierung (/api/cron/tick).
# Vercel setzt CRON_SECRET automatisch wenn Crons aktiviert sind.
# Für lokale Tests: beliebiger String.
# CRON_SECRET="dein-cron-geheimnis"

# ----------------------------------------------------------------------------
# Web-Push-Benachrichtigungen (VAPID)
# ----------------------------------------------------------------------------
# Ohne gesetzte Werte wird automatisch ein Schlüsselpaar erzeugt und unter
# .vapid-keys.json abgelegt (nur für lokale Entwicklung geeignet).
# Erzeugen: `npx web-push generate-vapid-keys`
# VAPID_PUBLIC_KEY="<public key>"
# VAPID_PRIVATE_KEY="<private key>"

# ----------------------------------------------------------------------------
# Lokaler Ollama-Server (optional)
# ----------------------------------------------------------------------------
# OLLAMA_BASE_URL="http://localhost:11434"
